# ===== Aplicação =====
SECRET_KEY=troque-por-uma-chave-secreta-forte

# ===== Banco de dados =====
# Deixe em branco para usar SQLite local. No Render, é preenchida
# automaticamente ao conectar um banco PostgreSQL.
DATABASE_URL=

# ===== Twilio (WhatsApp) =====
# Pegue em https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de Sandbox padrão do Twilio (não precisa trocar em testes)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Números que devem receber os alertas (os mesmos que deram "join <código>"
# no Sandbox). Aceita mais de um número separado por vírgula:
# WHATSAPP_DESTINO=whatsapp:+55DDDNUMERO1,whatsapp:+55DDDNUMERO2
WHATSAPP_DESTINO=whatsapp:+55DDDNUMERO

# ===== Regras de notificação =====
# Quantos dias antes do vencimento (e vencidos) entram no alerta
DIAS_ALERTA=3
# Token que protege POST /api/notificacoes/verificar (gere um valor aleatório)
NOTIFICACOES_TOKEN=troque-por-um-token-aleatorio
# Horário do agendador interno, se SCHEDULER_ATIVO=true (fuso America/Sao_Paulo)
NOTIFICACOES_HORA=08:00
# true = liga o agendador interno (BackgroundScheduler) dentro do próprio app.
# Recomendado deixar false no Render free e usar um cron externo chamando
# /api/notificacoes/verificar (veja o README).
SCHEDULER_ATIVO=false
